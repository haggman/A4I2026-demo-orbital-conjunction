# Cymbal Orbital demo — settings you might change.
#
# The agent reads this file when it starts (adk web, the smoke test, the model check), and agent/deploy.sh
# copies these values to Cloud Run. Edit, then restart what is running, or redeploy.
# A variable you export in your shell wins over this file; `source scripts/activate.sh` prints what is in force.

# ---- The model ---------------------------------------------------------------------------------------------
# Any Gemini model ID your project can use. To try another, change this line (and check it with
# `python agent/model_check.py`, which times it against the others below).
A4I_MODEL=gemini-3.8-flash
# Where it is served from. "global" is Google's recommendation for the newest models.
A4I_MODEL_LOCATION=global
# minimal, low, medium or high. Leave it empty for a model that rejects a thinking level.
A4I_THINKING_LEVEL=low
# Empty = standard pay-as-you-go. "priority" asks for Priority PayGo (a premium price per token; untested here).
A4I_SERVICE_TIER=
# Other models for `python agent/model_check.py` to time alongside A4I_MODEL, space-separated.
A4I_MODEL_CANDIDATES=

# ---- Patience with a slow model ------------------------------------------------------------------------------
# Seconds the first try at each step may take; every retry gets twice as long, after an exponential pause
# (1, 2, 4, then 8 s at most). Attempts counts every try, the first included.
A4I_MODEL_TIMEOUT_S=20
A4I_MODEL_ATTEMPTS=4

# ---- The rest -------------------------------------------------------------------------------------------------
# The BigQuery dataset the agent reads.
A4I_DATASET=a4i_orbit
# How the model's code reaches the sandbox: "tool" (our run_in_sandbox tool) or "executor" (ADK's code executor).
A4I_CODE_PATH=tool
# One [timing] line per step in the logs: 1 on, 0 off.
A4I_TIMING_LOGS=1
